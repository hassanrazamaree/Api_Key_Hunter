<UserControl x:Class="APIKeyHunter.WPF.Views.ResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:APIKeyHunter.WPF.ViewModels">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- Header + toolbar -->
            <RowDefinition Height="*" />      <!-- DataGrid / empty state -->
            <RowDefinition Height="Auto" />   <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════
             TOOLBAR
        ══════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="32,16,32,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Page heading + export actions -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Results"
                                   Style="{StaticResource TitleText}" />
                        <TextBlock Text="Discovered keys from completed scan operations."
                                   Style="{StaticResource BodyText}"
                                   Margin="0,3,0,0" />
                    </StackPanel>

                    <!-- Export + delete actions -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                VerticalAlignment="Bottom">
                        <Button Style="{StaticResource SecondaryButton}"
                                Content="Export CSV"
                                Command="{Binding ExportCsvCommand}"
                                Margin="0,0,8,0" />
                        <Button Style="{StaticResource SecondaryButton}"
                                Content="Export JSON"
                                Command="{Binding ExportJsonCommand}"
                                Margin="0,0,8,0" />
                        <Button Style="{StaticResource SecondaryButton}"
                                Content="Revalidate"
                                Command="{Binding RevalidatePlaceholderCommand}"
                                Margin="0,0,8,0"
                                ToolTip="Queue selected key for revalidation (connect backend to activate)" />
                        <Button Style="{StaticResource DangerButton}"
                                Content="Delete Selected"
                                Command="{Binding DeleteSelectedCommand}"
                                IsEnabled="{Binding SelectedKey, Converter={StaticResource NullOrEmptyToVisibility}}" />
                    </StackPanel>
                </Grid>

                <!-- Filter row -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Search -->
                    <Grid Grid.Column="0">
                        <TextBox Style="{StaticResource InputBox}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="Search provider or key preview…" />
                    </Grid>

                    <!-- Provider filter -->
                    <ComboBox Grid.Column="2"
                              Style="{StaticResource InputCombo}"
                              ItemsSource="{Binding AvailableProviders}"
                              SelectedItem="{Binding ProviderFilter}"
                              MinHeight="36">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding}" Value="">
                                                    <Setter Property="Text" Value="All providers" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                    <Setter Property="Text" Value="All providers" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Status filter -->
                    <ComboBox Grid.Column="4"
                              Style="{StaticResource InputCombo}"
                              ItemsSource="{Binding StatusOptions}"
                              SelectedItem="{Binding StatusFilter}"
                              MinHeight="36">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                    <Setter Property="Text" Value="All statuses" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Valid-only toggle -->
                    <CheckBox Grid.Column="6"
                              Style="{StaticResource DarkCheckBox}"
                              Content="Valid only"
                              IsChecked="{Binding ValidOnly}"
                              VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════
             CONTENT AREA  (grid or empty state)
        ══════════════════════════════════════ -->

        <!-- Loading indicator -->
        <Grid Grid.Row="1">
            <TextBlock Text="Loading…"
                       Style="{StaticResource BodyText}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

            <!-- Empty state (no data at all) -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="420">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsLoading}" Value="False" />
                                    <Condition Binding="{Binding KeysView.IsEmpty}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <!-- Empty state icon placeholder -->
                <Border Width="56" Height="56"
                        CornerRadius="12"
                        Background="{StaticResource SurfaceCardBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,20">
                    <TextBlock Text="∅"
                               FontSize="24"
                               Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <TextBlock Text="No results available"
                           FontFamily="{StaticResource FontSans}"
                           FontSize="{StaticResource FontSizeLg}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" />

                <TextBlock Text="Run a scan or import test data to view results."
                           Style="{StaticResource BodyText}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,6,0,0" />
            </StackPanel>

            <!-- DataGrid -->
            <DataGrid Style="{StaticResource ResultsGrid}"
                      ItemsSource="{Binding KeysView}"
                      SelectedItem="{Binding SelectedKey, Mode=TwoWay}"
                      Margin="0">
                <DataGrid.Style>
                    <Style TargetType="DataGrid" BasedOn="{StaticResource ResultsGrid}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding KeysView.IsEmpty}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Style>

                <DataGrid.Columns>
                    <!-- Provider -->
                    <DataGridTextColumn Header="Provider"
                                        Binding="{Binding Provider}"
                                        Width="140"
                                        ElementStyle="{StaticResource MonoText}" />

                    <!-- Key Preview -->
                    <DataGridTextColumn Header="Key Preview"
                                        Binding="{Binding KeyPreview}"
                                        Width="*"
                                        ElementStyle="{StaticResource MonoText}" />

                    <!-- Status (coloured badge via template) -->
                    <DataGridTemplateColumn Header="Status" Width="110" SortMemberPath="Status">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="{StaticResource RadiusSm}"
                                        Padding="8,3,8,3"
                                        HorizontalAlignment="Left"
                                        Margin="12,0,12,0"
                                        Background="{Binding Status, Converter={StaticResource KeyStatusToBrush}}">
                                    <TextBlock Text="{Binding Status}"
                                               FontFamily="{StaticResource FontMono}"
                                               FontSize="{StaticResource FontSizeXs}"
                                               Foreground="#0D1117"
                                               FontWeight="SemiBold" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Discovered At -->
                    <DataGridTextColumn Header="Discovered"
                                        Binding="{Binding DiscoveredAt, Converter={StaticResource DateTimeFormat}}"
                                        Width="150"
                                        ElementStyle="{StaticResource CaptionText}" />

                    <!-- Last Checked -->
                    <DataGridTextColumn Header="Last Checked"
                                        Binding="{Binding LastCheckedAt, Converter={StaticResource DateTimeFormat}}"
                                        Width="150"
                                        ElementStyle="{StaticResource CaptionText}" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- ══════════════════════════════════════
             STATUS BAR
        ══════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="32,8,32,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Feedback messages -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SuccessMessage}"
                               Foreground="{StaticResource SuccessBrush}"
                               FontFamily="{StaticResource FontSans}"
                               FontSize="{StaticResource FontSizeSm}"
                               VerticalAlignment="Center"
                               Visibility="{Binding SuccessMessage, Converter={StaticResource NullOrEmptyToVisibility}}" />
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{StaticResource DangerBrush}"
                               FontFamily="{StaticResource FontSans}"
                               FontSize="{StaticResource FontSizeSm}"
                               VerticalAlignment="Center"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVisibility}}" />
                </StackPanel>

                <!-- Row count -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontFamily="{StaticResource FontMono}"
                               FontSize="{StaticResource FontSizeSm}"
                               Foreground="{StaticResource TextMutedBrush}">
                        <Run Text="{Binding KeysView.Count, Mode=OneWay}" />
                        <Run Text=" rows" />
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
