<UserControl x:Class="APIKeyHunter.WPF.Views.ValidatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ── Left: Control panel ── -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,28,16,28">
                <TextBlock Text="Validator"
                           Style="{StaticResource TitleText}" />
                <TextBlock Text="Validate queued keys against their providers. Connect a test provider to activate."
                           Style="{StaticResource BodyText}"
                           Margin="0,6,0,20" />

                <!-- Config card -->
                <Border Style="{StaticResource SurfaceCard}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Queue"
                                   Style="{StaticResource SubheadingText}"
                                   Margin="0,0,0,14" />

                        <!-- Queue count display -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Queue size" Style="{StaticResource SubheadingText}" />
                                <TextBlock Text="{Binding QueueCount, Converter={StaticResource QueueCount}}"
                                           Style="{StaticResource MonoText}"
                                           FontSize="{StaticResource FontSizeLg}"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Processed" Style="{StaticResource SubheadingText}" />
                                <TextBlock Text="{Binding ProcessedCount}"
                                           Style="{StaticResource MonoText}"
                                           FontSize="{StaticResource FontSizeLg}"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- Target count -->
                        <TextBlock Text="Target count" Style="{StaticResource SubheadingText}" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource InputBox}"
                                 Text="{Binding TargetCount, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,0" />
                    </StackPanel>
                </Border>

                <!-- Current item -->
                <Border Style="{StaticResource SurfaceCard}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.ColumnSpan="2" Grid.Row="0"
                                   Text="Current Item"
                                   Style="{StaticResource SubheadingText}" />

                        <StackPanel Grid.Column="0" Grid.Row="2">
                            <TextBlock Text="Provider" Style="{StaticResource SubheadingText}" />
                            <TextBlock Text="{Binding CurrentProvider}"
                                       Style="{StaticResource MonoText}"
                                       Foreground="{StaticResource AccentBrush}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Grid.Row="2">
                            <TextBlock Text="Status" Style="{StaticResource SubheadingText}" />
                            <TextBlock Text="{Binding CurrentStatus}"
                                       Style="{StaticResource MonoText}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <!-- Progress bar -->
                        <ProgressBar Grid.ColumnSpan="2" Grid.Row="4"
                                     Style="{StaticResource ScanProgressBar}"
                                     Value="{Binding ProgressValue}"
                                     Minimum="0" Maximum="100" />

                        <!-- % -->
                        <TextBlock Grid.ColumnSpan="2" Grid.Row="6"
                                   Text="{Binding ProgressValue, Converter={StaticResource Percentage}}"
                                   Style="{StaticResource MonoText}"
                                   Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Right" />
                    </Grid>
                </Border>

                <!-- Controls -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{StaticResource SuccessButton}"
                            Content="Start" Command="{Binding StartCommand}" Padding="0,8,0,8" />

                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}"
                            Command="{Binding PauseOrResumeCommand}"
                            Padding="0,8,0,8">
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Pause" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPausedState}" Value="True">
                                            <Setter Property="Text" Value="Resume" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>

                    <Button Grid.Column="4" Style="{StaticResource DangerButton}"
                            Content="Stop" Command="{Binding StopCommand}"
                            Padding="0,8,0,8" />
                </Grid>

                <!-- Error -->
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource DangerBrush}"
                           Style="{StaticResource BodyText}"
                           Margin="0,10,0,0"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVisibility}}" />
            </StackPanel>
        </ScrollViewer>

        <!-- Divider -->
        <Border Grid.Column="1" Background="{StaticResource BorderBrush}" />

        <!-- ── Right: Validation history ── -->
        <Grid Grid.Column="2" Margin="24,28,32,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Validation History"
                       Style="{StaticResource HeadingText}" />

            <!-- Empty state -->
            <StackPanel Grid.Row="2"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding History.Count, Converter={StaticResource NullOrEmptyToVisibility}, ConverterParameter=invert}">
                <TextBlock Text="No validation history"
                           Style="{StaticResource HeadingText}"
                           Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Start validation to see results here."
                           Style="{StaticResource BodyText}"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0" />
            </StackPanel>

            <!-- History list -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding History.Count, Converter={StaticResource NullOrEmptyToVisibility}}">
                <ItemsControl ItemsSource="{Binding History}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource StatCard}" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding KeyPreview}"
                                                   Style="{StaticResource MonoText}" />
                                        <TextBlock Text="{Binding Provider}"
                                                   Style="{StaticResource CaptionText}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Status, Converter={StaticResource ValidationStatusFormat}}"
                                               Style="{StaticResource MonoText}"
                                               FontSize="{StaticResource FontSizeSm}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
