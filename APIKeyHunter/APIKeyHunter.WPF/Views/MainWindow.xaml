<Window x:Class="APIKeyHunter.WPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:APIKeyHunter.WPF.ViewModels"
        xmlns:views="clr-namespace:APIKeyHunter.WPF.Views"
        Title="APIKeyHunter"
        MinWidth="1000" MinHeight="640"
        Width="1280" Height="780"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <!-- DataTemplate routing -->
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TokenManagerViewModel}">
            <views:TokenManagerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ScannerViewModel}">
            <views:ScannerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ValidatorViewModel}">
            <views:ValidatorView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ResultsViewModel}">
            <views:ResultsView />
        </DataTemplate>
    </Window.Resources>

    <Border Background="{StaticResource BackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />    <!-- Title bar -->
                <RowDefinition Height="*" />     <!-- Content -->
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════
                 CUSTOM TITLE BAR
            ══════════════════════════════════════ -->
            <Border Grid.Row="0"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" />   <!-- matches sidebar -->
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- App brand -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="16,0,0,0">
                        <!-- Logo mark -->
                        <Border Width="22" Height="22" CornerRadius="5"
                                Background="{StaticResource AccentBrush}"
                                Margin="0,0,8,0">
                            <TextBlock Text="K" Foreground="#0D1117" FontWeight="Bold"
                                       FontSize="13" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="APIKeyHunter"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontFamily="{StaticResource FontSans}"
                                   FontSize="{StaticResource FontSizeMd}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Window controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="0,0,8,0">
                        <Button Style="{StaticResource IconButton}"
                                Click="MinimiseButton_Click"
                                ToolTip="Minimise" Margin="2,0">
                            <Border Width="10" Height="2" Background="{StaticResource TextSecondaryBrush}" />
                        </Button>
                        <Button Style="{StaticResource IconButton}"
                                Click="MaximiseButton_Click"
                                ToolTip="Maximise" Margin="2,0">
                            <Border Width="10" Height="10"
                                    BorderBrush="{StaticResource TextSecondaryBrush}"
                                    BorderThickness="1.5"
                                    CornerRadius="1" />
                        </Button>
                        <Button x:Name="CloseButton"
                                Style="{StaticResource IconButton}"
                                Click="CloseButton_Click"
                                ToolTip="Close" Margin="2,0">
                            <!-- ✕ drawn with two rotated borders -->
                            <Grid Width="10" Height="10">
                                <Border Height="1.5" Width="13" Background="{StaticResource TextSecondaryBrush}"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <RotateTransform Angle="45" />
                                    </Border.RenderTransform>
                                </Border>
                                <Border Height="1.5" Width="13" Background="{StaticResource TextSecondaryBrush}"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <RotateTransform Angle="-45" />
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════
                 MAIN LAYOUT  (sidebar + content)
            ══════════════════════════════════════ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0"
                        Background="{StaticResource SidebarBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Navigation items -->
                        <StackPanel Grid.Row="0" Margin="8,8,8,0">
                            <TextBlock Style="{StaticResource SidebarSectionLabel}" Text="NAVIGATION" />

                            <RadioButton x:Name="NavDashboard"
                                         Style="{StaticResource NavItem}"
                                         IsChecked="True"
                                         Command="{Binding NavigateToDashboardCommand}">
                                Dashboard
                            </RadioButton>

                            <RadioButton x:Name="NavTokenManager"
                                         Style="{StaticResource NavItem}"
                                         Command="{Binding NavigateToTokenManagerCommand}">
                                Token Manager
                            </RadioButton>

                            <RadioButton x:Name="NavScanner"
                                         Style="{StaticResource NavItem}"
                                         Command="{Binding NavigateToScannerCommand}">
                                Scanner
                            </RadioButton>

                            <RadioButton x:Name="NavValidator"
                                         Style="{StaticResource NavItem}"
                                         Command="{Binding NavigateToValidatorCommand}">
                                Validator
                            </RadioButton>

                            <RadioButton x:Name="NavResults"
                                         Style="{StaticResource NavItem}"
                                         Command="{Binding NavigateToResultsCommand}">
                                Results
                            </RadioButton>
                        </StackPanel>

                        <!-- Status indicator -->
                        <Border Grid.Row="1" Padding="12,10,12,16">
                            <StackPanel>
                                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,10" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Status dot -->
                                    <Ellipse Width="7" Height="7" Margin="0,0,7,0"
                                             VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsIdle}" Value="False">
                                                        <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding StatusText}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontFamily="{StaticResource FontSans}"
                                               FontSize="{StaticResource FontSizeSm}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Content area -->
                <ContentPresenter Grid.Column="1"
                                  Content="{Binding CurrentViewModel}"
                                  Margin="0" />
            </Grid>

            <!-- Window resize grip -->
            <ResizeGrip Grid.Row="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,4,4"
                        Opacity="0.4" />
        </Grid>
    </Border>
</Window>
