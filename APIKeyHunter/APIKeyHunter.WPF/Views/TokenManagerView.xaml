<UserControl x:Class="APIKeyHunter.WPF.Views.TokenManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ── Left: Add token form ── -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,28,16,28">
                <TextBlock Text="Token Manager"
                           Style="{StaticResource TitleText}" />
                <TextBlock Text="Configure authentication tokens used during scanning. Tokens are stored masked and never exposed in full."
                           Style="{StaticResource BodyText}"
                           Margin="0,6,0,20" />

                <!-- Add token card -->
                <Border Style="{StaticResource SurfaceCard}">
                    <StackPanel>
                        <TextBlock Text="Add Token"
                                   Style="{StaticResource HeadingText}"
                                   Margin="0,0,0,16" />

                        <!-- Token name -->
                        <TextBlock Text="Token name"
                                   Style="{StaticResource SubheadingText}"
                                   Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource InputBox}"
                                 Text="{Binding TokenName, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="e.g. my-scan-token"
                                 Margin="0,0,0,14" />

                        <!-- Provider -->
                        <TextBlock Text="Provider"
                                   Style="{StaticResource SubheadingText}"
                                   Margin="0,0,0,4" />
                        <ComboBox Style="{StaticResource InputCombo}"
                                  ItemsSource="{Binding Providers}"
                                  SelectedItem="{Binding SelectedProvider}"
                                  Margin="0,0,0,14" />

                        <!-- Token value -->
                        <TextBlock Text="Token value"
                                   Style="{StaticResource SubheadingText}"
                                   Margin="0,0,0,4" />
                        <Grid Margin="0,0,0,6">
                            <TextBox x:Name="TokenVisibleBox"
                                     Style="{StaticResource InputBox}"
                                     Text="{Binding RawToken, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="Paste token here…"
                                     Visibility="{Binding IsTokenVisible, Converter={StaticResource BoolToVisibility}}" />
                            <PasswordBox x:Name="TokenPasswordBox"
                                         Style="{StaticResource InputPassword}"
                                         PasswordChar="•"
                                         Visibility="{Binding IsTokenVisible, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"
                                         x:FieldModifier="private" />
                        </Grid>
                        <Button Style="{StaticResource IconButton}"
                                Command="{Binding ToggleTokenVisibilityCommand}"
                                HorizontalAlignment="Right"
                                Margin="0,0,0,14">
                            <TextBlock FontFamily="{StaticResource FontSans}"
                                       FontSize="{StaticResource FontSizeSm}"
                                       Foreground="{StaticResource TextSecondaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Show" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTokenVisible}" Value="True">
                                                <Setter Property="Text" Value="Hide" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>

                        <!-- Save button -->
                        <Button Style="{StaticResource PrimaryButton}"
                                Command="{Binding SaveTokenCommand}"
                                Content="Save Token"
                                HorizontalAlignment="Stretch" />

                        <!-- Feedback -->
                        <TextBlock Text="{Binding SuccessMessage}"
                                   Foreground="{StaticResource SuccessBrush}"
                                   Style="{StaticResource BodyText}"
                                   Margin="0,8,0,0"
                                   Visibility="{Binding SuccessMessage, Converter={StaticResource NullOrEmptyToVisibility}}" />
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{StaticResource DangerBrush}"
                                   Style="{StaticResource BodyText}"
                                   Margin="0,8,0,0"
                                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVisibility}}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Divider -->
        <Border Grid.Column="1" Width="1"
                Background="{StaticResource BorderBrush}"
                VerticalAlignment="Stretch" />

        <!-- ── Right: Token list ── -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="24,28,24,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Stored Tokens"
                               Style="{StaticResource HeadingText}"
                               VerticalAlignment="Center" />
                    <Border Background="{StaticResource AccentSubtleBrush}"
                            CornerRadius="{StaticResource RadiusSm}"
                            Padding="8,2,8,2"
                            Margin="10,0,0,0">
                        <TextBlock Text="{Binding Tokens.Count}"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontFamily="{StaticResource FontMono}"
                                   FontSize="{StaticResource FontSizeSm}" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- Loading -->
            <TextBlock Grid.Row="1"
                       Text="Loading…"
                       Style="{StaticResource BodyText}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

            <!-- Empty state -->
            <StackPanel Grid.Row="1"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding Tokens.Count, Converter={StaticResource NullOrEmptyToVisibility}, ConverterParameter=invert}">
                <TextBlock Text="No tokens configured"
                           Style="{StaticResource HeadingText}"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource TextMutedBrush}" />
                <TextBlock Text="Add a token using the form on the left."
                           Style="{StaticResource BodyText}"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0" />
            </StackPanel>

            <!-- Token list -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding Tokens.Count, Converter={StaticResource NullOrEmptyToVisibility}}">
                <ItemsControl ItemsSource="{Binding Tokens}"
                              Margin="24,0,24,24">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource StatCard}" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="6" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Name + provider -->
                                    <StackPanel Grid.Column="0" Grid.Row="0"
                                                Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}"
                                                   Style="{StaticResource BodyText}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontWeight="SemiBold" />
                                        <Border Background="{StaticResource SurfaceElevatedBrush}"
                                                CornerRadius="{StaticResource RadiusSm}"
                                                Padding="6,1,6,1" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Provider}"
                                                       Style="{StaticResource CaptionText}"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Key preview + status -->
                                    <StackPanel Grid.Column="0" Grid.Row="2"
                                                Orientation="Horizontal">
                                        <TextBlock Text="{Binding Preview}"
                                                   Style="{StaticResource MonoText}"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                        <Border CornerRadius="{StaticResource RadiusSm}"
                                                Padding="6,1,6,1" Margin="10,0,0,0"
                                                Background="{Binding TestStatus, Converter={StaticResource TokenStatusToBrush}, ConverterParameter=subtle}">
                                            <TextBlock Text="{Binding TestStatus}"
                                                       Style="{StaticResource CaptionText}"
                                                       Foreground="{Binding TestStatus, Converter={StaticResource TokenStatusToBrush}}" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Actions -->
                                    <StackPanel Grid.Column="1" Grid.Row="0" Grid.RowSpan="3"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Button Style="{StaticResource SecondaryButton}"
                                                Content="Test"
                                                Padding="10,5,10,5"
                                                FontSize="{StaticResource FontSizeSm}"
                                                Command="{Binding DataContext.TestTokenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Margin="0,0,6,0" />
                                        <Button Style="{StaticResource DangerButton}"
                                                Content="Delete"
                                                Padding="10,5,10,5"
                                                FontSize="{StaticResource FontSizeSm}"
                                                Command="{Binding DataContext.DeleteTokenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
