<UserControl x:Class="APIKeyHunter.WPF.Views.ScannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ── Left: Configuration ── -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,28,16,28">
                <TextBlock Text="Scanner"
                           Style="{StaticResource TitleText}" />
                <TextBlock Text="Configure and launch a scan operation."
                           Style="{StaticResource BodyText}"
                           Margin="0,6,0,20" />

                <!-- Config card -->
                <Border Style="{StaticResource SurfaceCard}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Configuration"
                                   Style="{StaticResource SubheadingText}"
                                   Margin="0,0,0,14" />

                        <!-- Max results -->
                        <TextBlock Text="Max results" Style="{StaticResource SubheadingText}" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource InputBox}"
                                 Text="{Binding MaxResults, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,14" />

                        <!-- Delay -->
                        <TextBlock Text="Request delay (ms)" Style="{StaticResource SubheadingText}" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource InputBox}"
                                 Text="{Binding DelayMs, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,14" />

                        <!-- Providers -->
                        <TextBlock Text="Providers" Style="{StaticResource SubheadingText}" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding AvailableProviders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Style="{StaticResource DarkCheckBox}"
                                              IsChecked="{Binding IsEnabled}"
                                              Content="{Binding Name}"
                                              Margin="0,0,0,6" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Actions -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Style="{StaticResource SuccessButton}"
                            Content="Start Scan"
                            Command="{Binding StartScanCommand}"
                            IsEnabled="{Binding IsScanning, Converter={StaticResource BoolNegate}}" />
                    <Button Grid.Column="2"
                            Style="{StaticResource DangerButton}"
                            Content="Stop"
                            Padding="14,8,14,8"
                            Command="{Binding StopScanCommand}"
                            IsEnabled="{Binding IsScanning}" />
                </Grid>

                <!-- Error -->
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource DangerBrush}"
                           Style="{StaticResource BodyText}"
                           Margin="0,10,0,0"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVisibility}}" />
            </StackPanel>
        </ScrollViewer>

        <!-- Divider -->
        <Border Grid.Column="1" Background="{StaticResource BorderBrush}" />

        <!-- ── Right: Progress + log ── -->
        <Grid Grid.Column="2" Margin="24,28,32,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Status + progress -->
            <Border Grid.Row="0" Style="{StaticResource SurfaceCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Status label -->
                    <TextBlock Grid.Column="0" Grid.Row="0"
                               Text="{Binding CurrentStatus}"
                               Style="{StaticResource BodyText}"
                               Foreground="{StaticResource TextPrimaryBrush}" />

                    <!-- % -->
                    <TextBlock Grid.Column="2" Grid.Row="0"
                               Text="{Binding ProgressPercent}"
                               Style="{StaticResource MonoText}"
                               Foreground="{StaticResource AccentBrush}"
                               VerticalAlignment="Center" />

                    <!-- Progress bar -->
                    <ProgressBar Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="2"
                                 Style="{StaticResource ScanProgressBar}"
                                 Value="{Binding ProgressValue}"
                                 Minimum="0" Maximum="100" />

                    <!-- Rate limit warning -->
                    <TextBlock Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="4"
                               Text="{Binding RateLimitInfo}"
                               Foreground="{StaticResource WarningBrush}"
                               FontSize="{StaticResource FontSizeSm}"
                               FontFamily="{StaticResource FontSans}"
                               Visibility="{Binding IsRateLimited, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Border>

            <!-- Stats row -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="Discovered" Style="{StaticResource SubheadingText}" />
                        <TextBlock Text="{Binding Discovered}"
                                   Style="{StaticResource MonoText}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="{StaticResource FontSizeXl}"
                                   FontWeight="Bold"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="Valid" Style="{StaticResource SubheadingText}" />
                        <TextBlock Text="{Binding Valid}"
                                   Style="{StaticResource MonoText}"
                                   Foreground="{StaticResource SuccessBrush}"
                                   FontSize="{StaticResource FontSizeXl}"
                                   FontWeight="Bold"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="Processed" Style="{StaticResource SubheadingText}" />
                        <TextBlock Text="{Binding Processed}"
                                   Style="{StaticResource MonoText}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="{StaticResource FontSizeXl}"
                                   FontWeight="Bold"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Activity log -->
            <Border Grid.Row="4" Style="{StaticResource LogPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Activity"
                               Style="{StaticResource SubheadingText}"
                               Foreground="{StaticResource TextSecondaryBrush}" />

                    <!-- Empty log message -->
                    <TextBlock Grid.Row="2"
                               Text="No activity yet."
                               Style="{StaticResource LogText}"
                               Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding LogEntries.Count, Converter={StaticResource NullOrEmptyToVisibility}, ConverterParameter=invert}" />

                    <!-- Log entries -->
                    <ScrollViewer Grid.Row="2"
                                  x:Name="LogScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding LogEntries.Count, Converter={StaticResource NullOrEmptyToVisibility}}">
                        <ItemsControl ItemsSource="{Binding LogEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               Style="{StaticResource LogText}"
                                               Margin="0,1,0,1" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
