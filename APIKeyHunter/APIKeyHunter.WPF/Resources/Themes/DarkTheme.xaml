<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════
         DARK THEME — APIKeyHunter
         Palette: near-black base, slate surfaces, cyan accent
    ═══════════════════════════════════════════════════ -->

    <!-- Base surfaces -->
    <Color x:Key="ClrBackground">#0D1117</Color>
    <Color x:Key="ClrSurface">#161B22</Color>
    <Color x:Key="ClrSurfaceElevated">#1C2333</Color>
    <Color x:Key="ClrSurfaceCard">#21262D</Color>
    <Color x:Key="ClrBorder">#30363D</Color>
    <Color x:Key="ClrBorderStrong">#484F58</Color>

    <!-- Text -->
    <Color x:Key="ClrTextPrimary">#E6EDF3</Color>
    <Color x:Key="ClrTextSecondary">#8B949E</Color>
    <Color x:Key="ClrTextMuted">#484F58</Color>
    <Color x:Key="ClrTextDisabled">#3D444D</Color>

    <!-- Accent — cyan-teal -->
    <Color x:Key="ClrAccent">#58A6FF</Color>
    <Color x:Key="ClrAccentHover">#79BAFF</Color>
    <Color x:Key="ClrAccentPressed">#388BFD</Color>
    <Color x:Key="ClrAccentSubtle">#1B2A3D</Color>

    <!-- Status colours -->
    <Color x:Key="ClrSuccess">#3FB950</Color>
    <Color x:Key="ClrSuccessSubtle">#162621</Color>
    <Color x:Key="ClrWarning">#D29922</Color>
    <Color x:Key="ClrWarningSubtle">#272115</Color>
    <Color x:Key="ClrDanger">#F85149</Color>
    <Color x:Key="ClrDangerSubtle">#2D1517</Color>
    <Color x:Key="ClrInfo">#58A6FF</Color>
    <Color x:Key="ClrInfoSubtle">#1B2A3D</Color>

    <!-- Sidebar -->
    <Color x:Key="ClrSidebar">#0D1117</Color>
    <Color x:Key="ClrSidebarHover">#1C2333</Color>
    <Color x:Key="ClrSidebarActive">#1C2333</Color>

    <!-- SolidColorBrushes -->
    <SolidColorBrush x:Key="BackgroundBrush"          Color="{StaticResource ClrBackground}" />
    <SolidColorBrush x:Key="SurfaceBrush"             Color="{StaticResource ClrSurface}" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush"     Color="{StaticResource ClrSurfaceElevated}" />
    <SolidColorBrush x:Key="SurfaceCardBrush"         Color="{StaticResource ClrSurfaceCard}" />
    <SolidColorBrush x:Key="BorderBrush"              Color="{StaticResource ClrBorder}" />
    <SolidColorBrush x:Key="BorderStrongBrush"        Color="{StaticResource ClrBorderStrong}" />
    <SolidColorBrush x:Key="TextPrimaryBrush"         Color="{StaticResource ClrTextPrimary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush"       Color="{StaticResource ClrTextSecondary}" />
    <SolidColorBrush x:Key="TextMutedBrush"           Color="{StaticResource ClrTextMuted}" />
    <SolidColorBrush x:Key="TextDisabledBrush"        Color="{StaticResource ClrTextDisabled}" />
    <SolidColorBrush x:Key="AccentBrush"              Color="{StaticResource ClrAccent}" />
    <SolidColorBrush x:Key="AccentHoverBrush"         Color="{StaticResource ClrAccentHover}" />
    <SolidColorBrush x:Key="AccentPressedBrush"       Color="{StaticResource ClrAccentPressed}" />
    <SolidColorBrush x:Key="AccentSubtleBrush"        Color="{StaticResource ClrAccentSubtle}" />
    <SolidColorBrush x:Key="SuccessBrush"             Color="{StaticResource ClrSuccess}" />
    <SolidColorBrush x:Key="SuccessSubtleBrush"       Color="{StaticResource ClrSuccessSubtle}" />
    <SolidColorBrush x:Key="WarningBrush"             Color="{StaticResource ClrWarning}" />
    <SolidColorBrush x:Key="WarningSubtleBrush"       Color="{StaticResource ClrWarningSubtle}" />
    <SolidColorBrush x:Key="DangerBrush"              Color="{StaticResource ClrDanger}" />
    <SolidColorBrush x:Key="DangerSubtleBrush"        Color="{StaticResource ClrDangerSubtle}" />
    <SolidColorBrush x:Key="InfoBrush"                Color="{StaticResource ClrInfo}" />
    <SolidColorBrush x:Key="SidebarBrush"             Color="{StaticResource ClrSidebar}" />
    <SolidColorBrush x:Key="SidebarHoverBrush"        Color="{StaticResource ClrSidebarHover}" />
    <SolidColorBrush x:Key="SidebarActiveBrush"       Color="{StaticResource ClrSidebarActive}" />
    <SolidColorBrush x:Key="TransparentBrush"         Color="Transparent" />

    <!-- Typography scale -->
    <FontFamily x:Key="FontMono">Cascadia Code, Consolas, Courier New</FontFamily>
    <FontFamily x:Key="FontSans">Segoe UI, Arial</FontFamily>
    <system:Double x:Key="FontSizeXs"   xmlns:system="clr-namespace:System;assembly=mscorlib">10</system:Double>
    <system:Double x:Key="FontSizeSm"   xmlns:system="clr-namespace:System;assembly=mscorlib">11</system:Double>
    <system:Double x:Key="FontSizeBase" xmlns:system="clr-namespace:System;assembly=mscorlib">13</system:Double>
    <system:Double x:Key="FontSizeMd"   xmlns:system="clr-namespace:System;assembly=mscorlib">14</system:Double>
    <system:Double x:Key="FontSizeLg"   xmlns:system="clr-namespace:System;assembly=mscorlib">16</system:Double>
    <system:Double x:Key="FontSizeXl"   xmlns:system="clr-namespace:System;assembly=mscorlib">20</system:Double>
    <system:Double x:Key="FontSize2xl"  xmlns:system="clr-namespace:System;assembly=mscorlib">24</system:Double>

    <!-- Corner radii -->
    <CornerRadius x:Key="RadiusSm">3</CornerRadius>
    <CornerRadius x:Key="RadiusMd">6</CornerRadius>
    <CornerRadius x:Key="RadiusLg">10</CornerRadius>

    <!-- Spacing -->
    <Thickness x:Key="PaddingXs">4,2,4,2</Thickness>
    <Thickness x:Key="PaddingSm">8,6,8,6</Thickness>
    <Thickness x:Key="PaddingMd">12,10,12,10</Thickness>
    <Thickness x:Key="PaddingLg">20,16,20,16</Thickness>
    <Thickness x:Key="PaddingXl">28,24,28,24</Thickness>
    <Thickness x:Key="CardPadding">20,16,20,16</Thickness>
</ResourceDictionary>
